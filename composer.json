{
    "name": "clearcut/video-client",
    "description": "Laravel client for a clearcut-video service: watermarking and PII redaction for screen recordings",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Clearcut\\Video\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Clearcut\\Video\\ClearcutServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
